#!/usr/bin/env bash
set -euo pipefail
source "$(dirname -- "$0")/environment.sh"
if [[ ! -x "$SVM_NODE" ]]; then
  svm_archive="$SVM_ROOT/.cache/tool-downloads/node-v$svm_node_version-$svm_os-$svm_cpu.tar.gz"
  mkdir -p "$(dirname -- "$svm_archive")" "$(dirname -- "$(dirname -- "$(dirname -- "$SVM_NODE")")")"
  svm_hash="$(awk -v p="\"$svm_os-$svm_cpu\"" '$1 == p":" { found=1 } found && /"node":/ { in_node=1 } in_node && /"hash":/ { gsub(/[",]/,"",$2); print $2; exit }' "$SVM_ROOT/build/toolchain.lock.json")"
  [[ -n "$svm_hash" ]] || { echo "No reviewed Node archive." >&2; exit 1; }
  if [[ ! -f "$svm_archive" ]]; then
    curl --fail --show-error --location "https://nodejs.org/dist/v$svm_node_version/$(basename -- "$svm_archive")" -o "$svm_archive.partial"
    mv "$svm_archive.partial" "$svm_archive"
  fi
  if command -v sha256sum >/dev/null; then svm_actual="$(sha256sum "$svm_archive" | cut -d ' ' -f 1)"; else svm_actual="$(shasum -a 256 "$svm_archive" | cut -d ' ' -f 1)"; fi
  [[ "$svm_actual" == "$svm_hash" ]] || { echo "Node archive checksum mismatch." >&2; exit 1; }
  svm_stage="$(dirname -- "$(dirname -- "$SVM_NODE")").bootstrap-$$"
  mkdir "$svm_stage"
  trap 'rm -rf -- "$svm_stage"' EXIT
  tar -xzf "$svm_archive" -C "$svm_stage" --strip-components=1
  "$svm_stage/bin/node" "$SVM_ROOT/eng/bootstrap.mjs" "$@"
else
  exec "$SVM_NODE" "$SVM_ROOT/eng/bootstrap.mjs" "$@"
fi
